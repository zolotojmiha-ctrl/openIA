armada-sibir.ru, www.armada-sibir.ru {
    encode zstd gzip
    header X-Content-Type-Options nosniff
    redir /cabinet* https://app.armada-sibir.ru{uri} 308
    reverse_proxy web:8000
}
app.armada-sibir.ru {
    encode zstd gzip
    request_body {
        max_size 25MB
    }
    redir / /cabinet/ 302
    reverse_proxy web:8000
}

{$ARMADA_PUBLIC_DOMAIN}, www.{$ARMADA_PUBLIC_DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 6MB
    }
    header X-Content-Type-Options nosniff
    redir /cabinet* https://{$ARMADA_APP_DOMAIN}{uri} 308
    reverse_proxy web:8000
}
